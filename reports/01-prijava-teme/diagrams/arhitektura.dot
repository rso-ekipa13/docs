// Šepet — začetna shema arhitekture (C4, raven vsebnikov), kompaktna različica za IEEE (figure*)
// Izris: dot -Tpdf arhitektura.dot -o arhitektura.pdf
digraph sepet {
  graph [rankdir=TB, splines=spline, nodesep=0.16, ranksep=0.42, pad=0.05,
         fontname="TeX Gyre Heros", fontsize=10];
  node  [shape=plain, fontname="TeX Gyre Heros", fontsize=10];
  edge  [fontname="TeX Gyre Heros", fontsize=8.5, color="#3c4a5c", arrowsize=0.6, penwidth=1.0];

  app [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#2f6fd6" bgcolor="#e8f1ff">
    <tr><td><b>client-app</b> · Flutter (Android, splet) · šifriranje MLS na napravi</td></tr></table>>];
  fcm [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded,dashed" color="#666666" bgcolor="#f4f4f4">
    <tr><td><b>FCM</b> (zunanji API)</td></tr></table>>];
  gw [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#c77700" bgcolor="#fff4e0">
    <tr><td><b>Prehod API</b> · Envoy Gateway · TLS, JWT, omejevanje hitrosti</td></tr></table>>];
  blob [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#0a6ebd" bgcolor="#eaf4fc">
    <tr><td><b>Blob Storage</b></td></tr><tr><td><font point-size="8.5">šifrirane priponke</font></td></tr></table>>];
  func [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#0a6ebd" bgcolor="#eaf4fc">
    <tr><td><b>Azure Functions</b></td></tr><tr><td><font point-size="8.5">preverjanje, čiščenje</font></td></tr></table>>];

  identity [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded" color="#2f6fd6">
    <tr><td bgcolor="#2f6fd6"><font color="white"><b>identity</b></font></td></tr><tr><td><font point-size="8.5">OIDC · PostgreSQL</font></td></tr></table>>];
  keys [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded" color="#2f6fd6">
    <tr><td bgcolor="#2f6fd6"><font color="white"><b>keys</b></font></td></tr><tr><td><font point-size="8.5">PostgreSQL</font></td></tr></table>>];
  conv [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded" color="#2f6fd6">
    <tr><td bgcolor="#2f6fd6"><font color="white"><b>conversation</b></font></td></tr><tr><td><font point-size="8.5">ES/CQRS · PostgreSQL</font></td></tr></table>>];
  msg [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded" color="#2f6fd6">
    <tr><td bgcolor="#2f6fd6"><font color="white"><b>message</b></font></td></tr><tr><td bgcolor="#fbe3dc"><font point-size="8.5">ScyllaDB</font></td></tr></table>>];
  rt [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded" color="#2f6fd6">
    <tr><td bgcolor="#2f6fd6"><font color="white"><b>realtime</b></font></td></tr><tr><td><font point-size="8.5">brez baze</font></td></tr></table>>];
  media [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded" color="#2f6fd6">
    <tr><td bgcolor="#2f6fd6"><font color="white"><b>media</b></font></td></tr><tr><td><font point-size="8.5">PostgreSQL</font></td></tr></table>>];
  notif [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded" color="#2f6fd6">
    <tr><td bgcolor="#2f6fd6"><font color="white"><b>notification</b></font></td></tr><tr><td><font point-size="8.5">PostgreSQL</font></td></tr></table>>];

  nats [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#b0306a" bgcolor="#fff0f6">
    <tr><td><b>NATS JetStream</b> — dogodki (CloudEvents)</td></tr></table>>];

  { rank=same; fcm; app; }
  fcm -> app [style=invis];
  { rank=same; func; media; notif; rt; msg; conv; identity; keys; }
  gw [ordering=out];

  app -> blob [label="SAS", color="#0a6ebd", fontcolor="#0a6ebd"];
  app -> gw   [label="REST · GraphQL · WSS · OIDC", color="#2f6fd6", fontcolor="#2f6fd6", penwidth=1.6];
  fcm -> app  [label="push", color="#666666", fontcolor="#666666", style=dashed, constraint=false];

  gw -> func [style=invis];
  gw -> media    [label="REST", color="#2f6fd6", fontcolor="#2f6fd6"];
  gw -> notif    [label="REST", color="#2f6fd6", fontcolor="#2f6fd6"];
  gw -> rt       [label="WSS", color="#0f8b8d", fontcolor="#0f8b8d"];
  gw -> msg      [label="REST", color="#2f6fd6", fontcolor="#2f6fd6"];
  gw -> conv     [label="REST, GraphQL", color="#2f6fd6", fontcolor="#2f6fd6"];
  gw -> identity [label="OIDC", color="#1f8a4c", fontcolor="#1f8a4c"];
  gw -> keys     [label="REST", color="#2f6fd6", fontcolor="#2f6fd6"];

  msg  -> conv     [label="gRPC", color="#7b3fbf", fontcolor="#7b3fbf", penwidth=1.4, constraint=false];
  conv -> identity [label="gRPC", color="#7b3fbf", fontcolor="#7b3fbf", penwidth=1.4, constraint=false];
  fcm -> notif     [label="HTTPS", color="#666666", fontcolor="#666666", dir=back];
  blob -> media    [label="SAS", color="#0a6ebd", fontcolor="#0a6ebd", style=dashed, dir=back];
  blob -> func     [label="Event Grid", color="#0a6ebd", fontcolor="#0a6ebd", style=dashed];
  func -> media    [label="HTTPS", color="#0a6ebd", fontcolor="#0a6ebd", constraint=false];

  edge [color="#b0306a", style=dashed, arrowhead=normal, penwidth=1.0];
  keys     -> nats [dir=both];
  identity -> nats;
  conv     -> nats [dir=both];
  msg      -> nats [dir=both];
  rt       -> nats [dir=both];
  media    -> nats [dir=both];
  notif    -> nats [dir=back];
}
