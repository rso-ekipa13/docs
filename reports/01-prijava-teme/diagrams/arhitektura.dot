// Šepet — začetna shema arhitekture (C4, raven vsebnikov)
// Izris: dot -Tpdf arhitektura.dot -o arhitektura.pdf
digraph sepet {
  graph [rankdir=TB, splines=spline, nodesep=0.18, ranksep=0.6,
         fontname="Inter", fontsize=11, pad=0.12];
  node  [shape=plain, fontname="Inter", fontsize=10];
  edge  [fontname="Inter", fontsize=8.5, color="#3c4a5c", arrowsize=0.7];

  // ---------- odjemalec ----------
  app [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded" color="#2f6fd6" bgcolor="#e8f1ff">
      <tr><td><b>client-app</b> (Flutter: Android + splet)</td></tr>
      <tr><td><font point-size="8.5">ključi in šifriranje E2E samo na napravi · lokalna šifrirana zgodovina</font></td></tr></table>>];

  // ---------- rob: IAM, prehod, Azure ----------

  gw [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded" color="#c77700" bgcolor="#fff4e0">
      <tr><td><b>Prehod API — Envoy Gateway</b> (Gateway API)</td></tr>
      <tr><td><font point-size="8.5">TLS (cert-manager) · preverjanje JWT (JWKS) · omejevanje hitrosti<br/>usmerjanje L7 po poti · prenos trditev JWT v glave</font></td></tr></table>>];

    blob [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#0a6ebd" bgcolor="#eaf4fc">
        <tr><td><b>Blob Storage</b></td></tr><tr><td><font point-size="8">samo šifrirani bloki</font></td></tr></table>>];
    func [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#0a6ebd" bgcolor="#eaf4fc">
        <tr><td><b>Azure Functions</b></td></tr><tr><td><font point-size="8">media-functions<br/>preverjanje · čiščenje</font></td></tr></table>>];

  fcm [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded,dashed" color="#555555" bgcolor="#f4f4f4">
      <tr><td><b>Firebase Cloud Messaging</b></td></tr><tr><td><font point-size="8">zunanji API</font></td></tr></table>>];

  // ---------- mikrostoritve (vsaka s svojo bazo) ----------

    keys [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#2f6fd6" bgcolor="#ffffff">
      <tr><td bgcolor="#2f6fd6"><font color="white"><b>keys-service</b></font></td></tr>
      <tr><td><font point-size="8">imenik javnih ključev<br/>paketi ključev naprav<br/>dnevnik sprememb ključev</font></td></tr>
      <tr><td bgcolor="#eef1f5"><font point-size="8">PostgreSQL<br/><i>keys</i></font></td></tr></table>>];
    identity [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#2f6fd6" bgcolor="#ffffff">
      <tr><td bgcolor="#2f6fd6"><font color="white"><b>identity-service (IdP)</b></font></td></tr>
      <tr><td><font point-size="8">OAuth 2.0 · OpenID Connect<br/>računi · organizacije<br/>naprave · vloge</font></td></tr>
      <tr><td bgcolor="#eef1f5"><font point-size="8">PostgreSQL<br/><i>identity</i></font></td></tr></table>>];
    conv [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#2f6fd6" bgcolor="#ffffff">
      <tr><td bgcolor="#2f6fd6"><font color="white"><b>conversation-service</b></font></td></tr>
      <tr><td><font point-size="8">pogovori in skupine<br/>Event Sourcing + CQRS<br/>GraphQL (branje)</font></td></tr>
      <tr><td bgcolor="#eef1f5"><font point-size="8">PostgreSQL<br/><i>dogodki + projekcije</i></font></td></tr></table>>];
    msg [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#2f6fd6" bgcolor="#ffffff">
      <tr><td bgcolor="#2f6fd6"><font color="white"><b>message-service</b></font></td></tr>
      <tr><td><font point-size="8">šifrirane ovojnice<br/>vrstni red · sinhronizacija<br/>izginjajoča sporočila</font></td></tr>
      <tr><td bgcolor="#fbe3dc"><font point-size="8">ScyllaDB<br/><i>messages</i></font></td></tr></table>>];
    rt [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#2f6fd6" bgcolor="#ffffff">
      <tr><td bgcolor="#2f6fd6"><font color="white"><b>realtime-service</b></font></td></tr>
      <tr><td><font point-size="8">povezave WebSocket<br/>dostava v živo<br/>prisotnost · tipkanje</font></td></tr>
      <tr><td bgcolor="#eef1f5"><font point-size="8">brez lastne baze<br/><i>prisotnost v NATS KV</i></font></td></tr></table>>];
    media [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#2f6fd6" bgcolor="#ffffff">
      <tr><td bgcolor="#2f6fd6"><font color="white"><b>media-service</b></font></td></tr>
      <tr><td><font point-size="8">šifrirane priponke<br/>dostop SAS (valet key)<br/>kvote · potek</font></td></tr>
      <tr><td bgcolor="#eef1f5"><font point-size="8">PostgreSQL<br/><i>media</i></font></td></tr></table>>];
    notif [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="#2f6fd6" bgcolor="#ffffff">
      <tr><td bgcolor="#2f6fd6"><font color="white"><b>notification-service</b></font></td></tr>
      <tr><td><font point-size="8">potisna obvestila<br/>brez vsebine<br/>žetoni naprav</font></td></tr>
      <tr><td bgcolor="#eef1f5"><font point-size="8">PostgreSQL<br/><i>notifications</i></font></td></tr></table>>];

    nats [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded" color="#b0306a" bgcolor="#fff0f6">
      <tr><td><b>NATS JetStream</b> — posrednik dogodkov · dostava vsaj enkrat · CloudEvents + AsyncAPI</td></tr>
      <tr><td><font point-size="8.5">identity.* · keys.* · conversations.* · messages.* · media.* · realtime.*</font></td></tr></table>>];

  obs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded,dashed" color="#8892a0" bgcolor="#fafafa">
      <tr><td><b>Opazovanje</b> (vse storitve)</td></tr>
      <tr><td><font point-size="8">OpenTelemetry · Prometheus · Grafana<br/>Fluent Bit → Loki · opozorila</font></td></tr></table>>];

  legend [label=<<table border="0" cellborder="0" cellspacing="1" cellpadding="1">
      <tr><td align="left" colspan="2"><b>Legenda</b></td></tr>
      <tr><td align="left"><font color="#2f6fd6"><b>——</b></font></td><td align="left"><font point-size="8.5">REST / GraphQL (HTTPS, JSON)</font></td></tr>
      <tr><td align="left"><font color="#0f8b8d"><b>——</b></font></td><td align="left"><font point-size="8.5">WebSocket (WSS)</font></td></tr>
      <tr><td align="left"><font color="#7b3fbf"><b>——</b></font></td><td align="left"><font point-size="8.5">gRPC (HTTP/2, Protobuf)</font></td></tr>
      <tr><td align="left"><font color="#b0306a"><b>- - -</b></font></td><td align="left"><font point-size="8.5">dogodki NATS JetStream (asinhrono)</font></td></tr>
      <tr><td align="left"><font color="#1f8a4c"><b>——</b></font></td><td align="left"><font point-size="8.5">OIDC / OAuth 2.0 (identity-service)</font></td></tr>
      <tr><td align="left"><font color="#0a6ebd"><b>——</b></font></td><td align="left"><font point-size="8.5">storitve Azure (SAS, Event Grid, HTTPS)</font></td></tr>
      <tr><td align="left" colspan="2"><font point-size="8">Prehod, mikrostoritve, NATS in baze tečejo v gruči AKS; vsaka storitev<br/>s trajnimi podatki dostopa samo do svoje baze. Vse storitve<br/>preverjajo žetone JWT s ključi JWKS iz identity-service.</font></td></tr>
    </table>>];

  // ---------- razporeditev ----------
  { rank=same; fcm; app; }
  fcm -> app [style=invis];
  { rank=same; func; media; notif; rt; msg; conv; identity; keys; }
  { rank=same; nats; obs; legend; }
  gw  [ordering=out];
  app [ordering=out];

  // ---------- odjemalec ----------
  app -> blob [label=" PUT/GET šifriranega\n bloka (URL SAS)", color="#0a6ebd", fontcolor="#0a6ebd"];
  app -> gw  [label=" HTTPS: REST · GraphQL · WSS · OIDC", color="#2f6fd6", fontcolor="#2f6fd6", penwidth=1.8];

  // ---------- prehod -> storitve ----------
  gw -> func [style=invis];
  gw -> media    [label="REST", color="#2f6fd6", fontcolor="#2f6fd6"];
  gw -> notif    [label="REST", color="#2f6fd6", fontcolor="#2f6fd6"];
  gw -> rt       [label="WSS", color="#0f8b8d", fontcolor="#0f8b8d", penwidth=1.3];
  gw -> msg      [label="REST", color="#2f6fd6", fontcolor="#2f6fd6"];
  gw -> conv     [label="REST\nGraphQL", color="#2f6fd6", fontcolor="#2f6fd6"];
  gw -> identity [label="OIDC · REST\nJWKS", color="#1f8a4c", fontcolor="#1f8a4c", penwidth=1.4];
  gw -> keys     [label="REST", color="#2f6fd6", fontcolor="#2f6fd6"];

  // ---------- sinhrono med storitvami ----------
  conv -> identity [label="gRPC", color="#7b3fbf", fontcolor="#7b3fbf", penwidth=1.5, constraint=false];
  msg  -> conv     [label="gRPC", color="#7b3fbf", fontcolor="#7b3fbf", penwidth=1.5, constraint=false];
  fcm -> notif     [label="HTTPS + OAuth 2.0", color="#555555", fontcolor="#555555", dir=back];
  blob -> media    [label="izda SAS", color="#0a6ebd", fontcolor="#0a6ebd", style=dashed, dir=back];
  blob -> func     [label="Event Grid\nBlobCreated", color="#0a6ebd", fontcolor="#0a6ebd", style=dashed];
  func -> media    [label="HTTPS prek prehoda\n(OAuth 2.0)", color="#0a6ebd", fontcolor="#0a6ebd", constraint=false];
  fcm -> app       [label="potisno obvestilo\nbrez vsebine", color="#555555", fontcolor="#555555", style=dashed, constraint=false];

  // ---------- dogodki ----------
  edge [color="#b0306a", fontcolor="#b0306a", style=dashed, penwidth=1.2, labelfontsize=7.5];
  keys     -> nats [dir=both, taillabel="pub/sub"];
  identity -> nats [taillabel="pub"];
  conv     -> nats [dir=both, taillabel="pub/sub"];
  msg      -> nats [dir=both, taillabel="pub/sub"];
  rt       -> nats [dir=both, taillabel="pub/sub"];
  media    -> nats [dir=both, taillabel="pub/sub"];
  notif    -> nats [dir=back, taillabel="sub"];
}
